<h1><%= t ".title" %></h1>
<h1>Products</h1>
<%= link_to "New product", new_product_path%>
<div id="products">
  <% @products.each do |product| %>
    <div>
        <a href="/products/<%= product.id %>">
            <%= product.name %>
        </a>
    </div>
  <% end %>
</div>
<%= link_to "Login", new_session_path unless authenticated? %>
<%= link_to "Register", register_path unless authenticated? %>
